# --- Pflicht ---
SECRET_KEY=bitte-lange-zufaellige-zeichenfolge-setzen
# Schluessel fuer die verschluesselt gespeicherten Geheimnisse jeder Mandanten-Instanz (deren SECRET_KEY,
# FIELD_ENCRYPTION_KEY, Postgres- und Admin-Passwort). Erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ACHTUNG: Schluessel sichern! Ohne ihn sind die verwalteten Geheimnisse nicht mehr lesbar.
FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=bitte-aendern

# --- Betrieb ---
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
HTTPS=0
POSTGRES_DB=portalverwaltung
POSTGRES_USER=portal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/1

# --- Portalverwaltung ---
# Pfad zum lokalen Checkout des Feuerix-Quellcodes (Repo "vereinsverwaltung") - von dort wird
# docker-compose.yml direkt fuer jede neue Instanz verwendet (kein Kopieren).
FEUERIX_REPO_PFAD=../vereinsverwaltung
# Wo die generierten .env-Dateien je Mandant abgelegt werden.
INSTANZEN_VERZEICHNIS=./instanzen
# Erster zu vergebender Web-Port - jede neue Instanz bekommt automatisch den naechsten freien.
WEB_PORT_BASIS=8100
# Port-Basen der Zusatzdienste (Ausbaustufe 2), je Dienst wird der naechste freie Port vergeben.
PAPERLESS_PORT_BASIS=10100
OPENSLIDES_PORT_BASIS=9100
OPENSLIDES_MANAGE_PORT_BASIS=9200
# Ports vor der Vergabe auf dem Server auf Belegung pruefen (1/0).
PORT_PRUEFUNG=1

# Reverse-Proxy-Automatisierung (Ausbaustufe 1b): Adresse der Caddy-Admin-API, z. B. http://127.0.0.1:2019.
# Leer = aus (Reverse Proxy dann von Hand pflegen). Admin-API nur auf localhost erreichbar lassen!
CADDY_ADMIN_URL=
CADDY_ACME_EMAIL=
# Nur fuer Tests/lokal: reines HTTP ohne Zertifikate.
PROXY_NUR_HTTP=0

# Eigene Domain der Portalverwaltung (Weboberflaeche /admin/) - wird im Reverse Proxy mit eingetragen.
PORTAL_DOMAIN=
PORTAL_PORT=8000

# Update-Pruefung fuer Feuerix: Intervall in Stunden (0 = aus) und Pause zwischen den Instanzen beim Rollout.
UPDATE_PRUEFUNG_STUNDEN=6
UPDATE_PAUSE_SEKUNDEN=10
# Dauer der Anmeldung in der Weboberflaeche in Stunden.
SESSION_DAUER_STUNDEN=12
# Versionen von Paperless-ngx/OpenSlides erfassen und auf GitHub nach neuen Releases pruefen (1/0, nur Hinweis).
UPDATE_DIENSTE_PRUEFEN=1
# Aufbewahrung des Gesamtlogs in Tagen (0 = nie loeschen).
LOG_AUFBEWAHRUNG_TAGE=90
# Maximales Alter (Stunden) der letzten Sicherung, ab dem vor einem Update automatisch eine neue angelegt wird.
UPDATE_BACKUP_MAX_ALTER_STUNDEN=24
